#!/usr/bin/env bash
# Builds the optimizer if anything changed and runs it right here in your terminal, so a factory of blocks gets its
# live view and keys (`./gradlew run` runs it inside Gradle, without a terminal, so it falls back to plain output).
# Usage: ./optimize --config=<job.json> [--out=<dir>] [--until-stopped] [--resume=<dir>] [--plain] ...
# Memory: JAVA_OPTS (default -Xmx6g).
set -e
root="$(cd "$(dirname "$0")" && pwd)"
(cd "$root" && ./gradlew -q installDist)
export JAVA_OPTS="${JAVA_OPTS:--Xmx6g}"
exec "$root/build/install/factorio_optimizer_v2/bin/factorio_optimizer_v2" "$@"
